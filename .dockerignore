# Todo lo que no debe entrar en la imagen de VetPet Connect.
# Ojo: docker/ SÍ debe copiarse (el Dockerfile toma de ahí php.ini y entrypoint.sh).

# Dependencias: se instalan dentro de la imagen con composer install.
vendor/
node_modules/

# Control de versiones y metadatos
.git/
.gitignore
.gitattributes
.github/
.editorconfig

# Configuración local: nunca se hornea en la imagen.
.env
.env.*
!.env.example

# Registros, cachés y datos generados.
# Se excluye el CONTENIDO, no las carpetas: Laravel necesita que existan, por eso
# se vuelven a incluir los .gitignore que las mantienen en el repositorio.
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
bootstrap/cache/*.php
!storage/logs/.gitignore
!storage/framework/cache/data/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore
!storage/framework/testing/.gitignore
*.log
.phpunit.result.cache
.phpunit.cache/

# Bases de datos locales de pruebas
database/*.sqlite
database/*.sqlite-journal

# Compilados del front y herramientas
public/build/
public/hot
public/storage

# Editores y sistema operativo
.idea/
.vscode/
.fleet/
.nova/
.zed/
*.swp
.DS_Store
Thumbs.db

# Material del curso y entregables que no forman parte de la aplicación
docs/
basedatos/
backend/
sitio-web/
pruebas/
*.pptx
*.docx

# La propia configuración de despliegue estático
netlify.toml
vercel.json
